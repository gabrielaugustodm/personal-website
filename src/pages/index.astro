---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Gabriel Gomes" description="Personal website of Gabriel Gomes.">
  <main>

    <!-- Nav -->
    <nav>
      <span class="nav-name">gg</span>
      <div class="nav-right">
        <ul>
          <li><a href="#about" data-i18n="nav.about">About</a></li>
          <li><a href="#projects" data-i18n="nav.projects">Projects</a></li>
          <li><a href="#contact" data-i18n="nav.contact">Contact</a></li>
        </ul>
        <button class="lang-toggle" aria-label="Switch language">PT</button>
      </div>
    </nav>

    <!-- Hero -->
    <section class="hero">
      <p class="hero-label" data-i18n="hero.label">Hey, I'm</p>
      <h1>Gabriel Gomes</h1>
      <p class="hero-tagline" data-i18n-html="hero.tagline">
        Product Manager with a technical foundation.<br />
        13+ years across fintech, SaaS, and consulting.
      </p>
      <div class="hero-cta">
        <a href="#projects" class="btn-primary" data-i18n="hero.ctaPrimary">See my work</a>
        <a href="#contact" class="btn-secondary" data-i18n="hero.ctaSecondary">Get in touch</a>
      </div>
    </section>

    <!-- About -->
    <section class="section animate" id="about">
      <span class="section-label" data-i18n="about.label">About</span>
      <div class="about-grid">
        <div>
          <img src="/profile.png" alt="Gabriel Gomes" class="profile-photo" />
          <h2 data-i18n="about.heading">A bit about me</h2>
          <p data-i18n="about.bio1">
            I'm Gabriel, a Product Manager with over 13 years of experience across
            fintech, SaaS, and consulting. I hold a post-graduate degree in Service
            Design and began my career as a developer — pivoting into product after
            an international scholarship in tech and innovation.
          </p>
          <p data-i18n="about.bio2">
            I've led cross-functional teams, worked across industries and continents,
            and built products that are simple, scalable, and rooted in real customer
            needs.
          </p>
          <a href="/resume.pdf" download class="btn-secondary resume-btn" data-i18n="about.downloadCV">Download CV →</a>
        </div>
        <div class="skills">
          <p class="skills-label" data-i18n="about.skillsLabel">Things I work with</p>
          <ul>
            <li>Product Strategy & Roadmap</li>
            <li>Agile / Scrum</li>
            <li>UX Research & Service Design</li>
            <li>Open Banking & eInvoicing</li>
            <li>Google Analytics, Mixpanel & SQL</li>
            <li>Portuguese, English & Spanish</li>
          </ul>
        </div>
      </div>
    </section>

    <!-- Projects -->
    <section class="section animate" id="projects">
      <span class="section-label" data-i18n="projects.label">Projects</span>
      <h2 data-i18n="projects.heading">Selected work</h2>
      <div class="projects-grid">
        <article class="project-card animate">
          <div class="project-top">
            <span class="project-number">01</span>
          </div>
          <h3 data-i18n="projects.card1.title">SumUp Invoices</h3>
          <p data-i18n="projects.card1.desc">Owned the end-to-end invoicing product for a global fintech, launching across European markets and expanding to Brazil, the US and Australia. Grew a subscription offer from 0 to 1, reaching ~45% of users and ~€1.9M ARR within two years.</p>
          <div class="project-tags">
            <span>Fintech</span>
            <span>eInvoicing</span>
            <span>Open Banking</span>
            <span>SaaS</span>
          </div>
        </article>

        <article class="project-card animate">
          <div class="project-top">
            <span class="project-number">02</span>
          </div>
          <h3 data-i18n="projects.card2.title">Innovation Consulting — Porsche Consulting</h3>
          <p data-i18n="projects.card2.desc">Helped clients across Mobility, Hospitality, Tourism, and Construction develop human-centered strategies. Facilitated design sprints, product vision workshops, and led steering meetings for C-level stakeholders.</p>
          <div class="project-tags">
            <span>Service Design</span>
            <span>Innovation</span>
            <span>Strategy</span>
            <span>Workshops</span>
          </div>
        </article>

        <article class="project-card animate">
          <div class="project-top">
            <span class="project-number">03</span>
          </div>
          <h3 data-i18n="projects.card3.title">HandMade Design / Thoughtworks</h3>
          <p data-i18n="projects.card3.desc">Led product discovery and customer journey mapping for Santander Brazil, ran A/B testing and experimentation for Guide Investimentos, and conducted user research focused on personas for OLX Brazil.</p>
          <div class="project-tags">
            <span>Product Discovery</span>
            <span>UX Research</span>
            <span>A/B Testing</span>
            <span>Journey Mapping</span>
          </div>
        </article>
      </div>
    </section>

    <!-- Contact -->
    <section class="section animate" id="contact">
      <span class="section-label" data-i18n="contact.label">Contact</span>
      <div class="contact-inner">
        <h2 data-i18n="contact.heading">Let's talk</h2>
        <p data-i18n="contact.desc">I'm always open to interesting conversations, new opportunities, or just a good chat about product. Feel free to reach out.</p>
        <a href="mailto:gabrielaugustodm@gmail.com" class="btn-primary" data-i18n="contact.cta">Say hello →</a>
        <div class="socials">
          <a href="https://www.linkedin.com/in/gabrielaugustogomes" target="_blank" rel="noopener">LinkedIn</a>
        </div>
      </div>
    </section>

    <!-- Footer -->
    <footer>
      <p data-i18n="footer">Designed & built by Gabriel Gomes</p>
    </footer>

  </main>
</Layout>

<style>
  main {
    max-width: 760px;
    margin: 0 auto;
    padding: 0 24px;
  }

  /* Nav */
  nav {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 32px 0;
  }

  .nav-name {
    font-size: 1rem;
    font-weight: 500;
    color: var(--accent);
    letter-spacing: 0.05em;
  }

  .nav-right {
    display: flex;
    align-items: center;
    gap: 24px;
  }

  nav ul {
    display: flex;
    gap: 32px;
    list-style: none;
  }

  nav ul a {
    font-size: 0.875rem;
    color: var(--text-secondary);
    transition: color 0.2s;
  }

  nav ul a:hover {
    color: var(--text-primary);
  }

  nav ul a.active {
    color: var(--text-primary);
  }

  .lang-toggle {
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--text-muted);
    background: none;
    border: 1px solid var(--border);
    padding: 4px 10px;
    border-radius: 4px;
    cursor: pointer;
    letter-spacing: 0.08em;
    transition: color 0.2s, border-color 0.2s;
    font-family: var(--font);
  }

  .lang-toggle:hover {
    color: var(--text-primary);
    border-color: var(--text-muted);
  }

  /* Hero */
  .hero {
    padding: 100px 0 120px;
  }

  .hero-label {
    font-size: 0.875rem;
    color: var(--text-muted);
    margin-bottom: 12px;
    letter-spacing: 0.05em;
  }

  .hero h1 {
    font-size: clamp(2.5rem, 6vw, 4rem);
    font-weight: 300;
    line-height: 1.1;
    letter-spacing: -0.02em;
    color: var(--text-primary);
    margin-bottom: 24px;
  }

  .hero-tagline {
    font-size: 1.125rem;
    color: var(--text-secondary);
    line-height: 1.7;
    max-width: 480px;
    margin-bottom: 40px;
  }

  .hero-cta {
    display: flex;
    gap: 16px;
    flex-wrap: wrap;
  }

  /* Buttons */
  .btn-primary {
    display: inline-block;
    padding: 12px 24px;
    background: var(--accent);
    color: var(--bg);
    font-size: 0.875rem;
    font-weight: 500;
    border-radius: 4px;
    transition: opacity 0.2s;
  }

  .btn-primary:hover {
    opacity: 0.85;
    color: var(--bg);
  }

  .btn-secondary {
    display: inline-block;
    padding: 12px 24px;
    border: 1px solid var(--border);
    color: var(--text-secondary);
    font-size: 0.875rem;
    border-radius: 4px;
    transition: border-color 0.2s, color 0.2s;
  }

  .btn-secondary:hover {
    border-color: var(--text-muted);
    color: var(--text-primary);
  }

  /* Sections */
  .section {
    padding: 80px 0;
    border-top: 1px solid var(--border);
  }

  .section-label {
    display: inline-block;
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--accent);
    margin-bottom: 32px;
  }

  .section h2 {
    font-size: 1.75rem;
    font-weight: 300;
    letter-spacing: -0.01em;
    margin-bottom: 24px;
    color: var(--text-primary);
  }

  .section p {
    color: var(--text-secondary);
    margin-bottom: 16px;
    max-width: 580px;
  }

  /* About */
  .about-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 48px;
    align-items: start;
  }

  @media (max-width: 580px) {
    .about-grid {
      grid-template-columns: 1fr;
    }
  }

  .profile-photo {
    width: 120px;
    height: 120px;
    border-radius: 50%;
    object-fit: cover;
    object-position: center top;
    margin-bottom: 24px;
    border: 2px solid var(--border);
    display: block;
  }

  .resume-btn {
    display: inline-block;
    margin-top: 24px;
  }

  .skills-label {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--text-muted);
    margin-bottom: 16px !important;
  }

  .skills ul {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .skills li {
    font-size: 0.9rem;
    color: var(--text-secondary);
    padding-left: 16px;
    position: relative;
  }

  .skills li::before {
    content: '—';
    position: absolute;
    left: 0;
    color: var(--text-muted);
  }

  /* Projects */
  .projects-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
    margin-top: 8px;
  }

  @media (max-width: 580px) {
    .projects-grid {
      grid-template-columns: 1fr;
    }
  }

  .project-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 24px;
    transition: border-color 0.2s;
  }

  .project-card:hover {
    border-color: var(--text-muted);
  }

  .project-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 16px;
  }

  .project-number {
    font-size: 0.75rem;
    color: var(--text-muted);
    font-weight: 500;
    letter-spacing: 0.05em;
  }

  .project-card h3 {
    font-size: 1rem;
    font-weight: 500;
    margin-bottom: 8px;
    color: var(--text-primary);
  }

  .project-card p {
    font-size: 0.875rem;
    color: var(--text-secondary);
    line-height: 1.6;
    margin-bottom: 16px;
    max-width: none;
  }

  .project-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .project-tags span {
    font-size: 0.75rem;
    color: var(--text-muted);
    border: 1px solid var(--border);
    padding: 2px 10px;
    border-radius: 999px;
  }

  /* Contact */
  .contact-inner {
    max-width: 480px;
  }

  .contact-inner .btn-primary {
    margin-top: 8px;
    margin-bottom: 40px;
  }

  .socials {
    display: flex;
    gap: 24px;
  }

  .socials a {
    font-size: 0.875rem;
    color: var(--text-muted);
    transition: color 0.2s;
  }

  .socials a:hover {
    color: var(--text-primary);
  }

  /* Mobile */
  @media (max-width: 580px) {
    .hero {
      padding: 60px 0 72px;
    }

    .section {
      padding: 56px 0;
    }

    nav ul {
      gap: 16px;
    }

    .about-grid {
      gap: 32px;
    }
  }

  /* Footer */
  footer {
    padding: 40px 0;
    border-top: 1px solid var(--border);
    margin-top: 40px;
  }

  footer p {
    font-size: 0.8rem;
    color: var(--text-muted);
  }

  /* Hero entrance animations */
  @keyframes fadeUp {
    from { opacity: 0; transform: translateY(32px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  .hero-label   { animation: fadeUp 0.7s ease both; animation-delay: 0.1s; }
  .hero h1      { animation: fadeUp 0.7s ease both; animation-delay: 0.3s; }
  .hero-tagline { animation: fadeUp 0.7s ease both; animation-delay: 0.5s; }
  .hero-cta     { animation: fadeUp 0.7s ease both; animation-delay: 0.7s; }

  /* Scroll animations */
  .animate {
    opacity: 0;
    transform: translateY(36px);
    transition: opacity 0.7s ease, transform 0.7s ease;
  }

  .animate.visible {
    opacity: 1;
    transform: translateY(0);
  }

  .project-card.animate:nth-child(2) { transition-delay: 0.15s; }
  .project-card.animate:nth-child(3) { transition-delay: 0.3s; }
</style>

<script>
  // ── Translations ──────────────────────────────────────────────
  const translations = {
    en: {
      nav: { about: 'About', projects: 'Projects', contact: 'Contact' },
      hero: {
        label: "Hey, I'm",
        tagline: 'Product Manager with a technical foundation.<br />13+ years across fintech, SaaS, and consulting.',
        ctaPrimary: 'See my work',
        ctaSecondary: 'Get in touch',
      },
      about: {
        label: 'About',
        heading: 'A bit about me',
        bio1: "I'm Gabriel, a Product Manager with over 13 years of experience across fintech, SaaS, and consulting. I hold a post-graduate degree in Service Design and began my career as a developer — pivoting into product after an international scholarship in tech and innovation.",
        bio2: "Born in Brazil, I've also called the US and Denmark home — experiences that shaped how I think about building for diverse markets. Currently back in São Paulo.",
        skillsLabel: 'Things I work with',
        skills: ['Product Strategy & Roadmap', 'Agile / Scrum', 'UX Research & Service Design', 'Open Banking & eInvoicing', 'Google Analytics, Mixpanel & SQL', 'Portuguese, English & travel-level Spanish'],
        downloadCV: 'Download CV →',
      },
      projects: {
        label: 'Projects',
        heading: 'Selected work',
        card1: {
          title: 'SumUp Invoices',
          desc: 'Owned the end-to-end invoicing product for a global fintech, launching across European markets and expanding to Brazil, the US and Australia. Grew a subscription offer from 0 to 1, reaching ~45% of users and ~€1.9M ARR within two years.',
        },
        card2: {
          title: 'Innovation Consulting — Porsche Consulting',
          desc: 'Helped clients across Mobility, Hospitality, Tourism, and Construction develop human-centered strategies. Facilitated design sprints, product vision workshops, and led steering meetings for C-level stakeholders.',
        },
        card3: {
          title: 'HandMade Design / Thoughtworks',
          desc: 'Led product discovery and customer journey mapping for Santander Brazil, ran A/B testing and experimentation for Guide Investimentos, and conducted user research focused on personas for OLX Brazil.',
        },
      },
      contact: {
        label: 'Contact',
        heading: "Let's talk",
        desc: "I'm always open to interesting conversations, new opportunities, or just a good chat about product. Feel free to reach out.",
        cta: 'Say hello →',
      },
      footer: 'Designed & built by Gabriel Gomes',
    },
    pt: {
      nav: { about: 'Sobre', projects: 'Projetos', contact: 'Contato' },
      hero: {
        label: 'Olá, sou o',
        tagline: 'Product Manager com base técnica.<br />Mais de 13 anos em fintech, SaaS e consultoria.',
        ctaPrimary: 'Ver meu trabalho',
        ctaSecondary: 'Falar comigo',
      },
      about: {
        label: 'Sobre',
        heading: 'Um pouco sobre mim',
        bio1: 'Sou o Gabriel, um Product Manager com mais de 13 anos de experiência em fintech, SaaS e consultoria. Tenho pós-graduação em Service Design e comecei minha carreira como desenvolvedor — migrando para produto após uma bolsa de estudos internacional em tecnologia e inovação.',
        bio2: 'Nascido no Brasil, também morei nos Estados Unidos e na Dinamarca — experiências que moldaram minha forma de construir produtos para mercados diversos. Atualmente de volta em São Paulo.',
        skillsLabel: 'Com o que trabalho',
        skills: ['Estratégia de Produto & Roadmap', 'Agile / Scrum', 'Pesquisa UX & Service Design', 'Open Banking & eInvoicing', 'Google Analytics, Mixpanel & SQL', 'Português, Inglês & Espanhol no nível viagem (um pouco melhor do que o Portunhol)'],
        downloadCV: 'Baixar CV →',
      },
      projects: {
        label: 'Projetos',
        heading: 'Trabalhos selecionados',
        card1: {
          title: 'SumUp Invoices',
          desc: 'Responsável pelo produto de notas fiscais de ponta a ponta em uma fintech global, com lançamentos em mercados europeus e expansão para Brasil, EUA e Austrália. Escalei um plano de assinatura do zero, chegando a ~45% dos usuários e ~€1,9M ARR em dois anos.',
        },
        card2: {
          title: 'Consultoria de Inovação — Porsche Consulting',
          desc: 'Apoiei clientes de Mobilidade, Hotelaria, Turismo e Construção no desenvolvimento de estratégias centradas no usuário. Facilitei design sprints, workshops de visão de produto e reuniões estratégicas com lideranças C-level.',
        },
        card3: {
          title: 'HandMade Design / Thoughtworks',
          desc: 'Liderei discovery de produto e mapeamento de jornada para o Santander Brasil, conduzi experimentos e testes A/B para a Guide Investimentos, e realizei pesquisa com usuários focada em personas para o OLX Brasil.',
        },
      },
      contact: {
        label: 'Contato',
        heading: 'Vamos conversar',
        desc: 'Estou sempre aberto a conversas interessantes, novas oportunidades ou um bom papo sobre produto. Fique à vontade para entrar em contato.',
        cta: 'Diga olá →',
      },
      footer: 'Desenhado e desenvolvido por Gabriel Gomes',
    },
  };

  // ── Helpers ───────────────────────────────────────────────────
  function getNestedValue(obj: Record<string, any>, key: string): string | undefined {
    return key.split('.').reduce((o, k) => (o && o[k] !== undefined ? o[k] : undefined), obj);
  }

  let currentLang = 'en';

  function applyTranslations(lang: string) {
    const t = translations[lang as keyof typeof translations];

    // Plain text
    document.querySelectorAll<HTMLElement>('[data-i18n]').forEach((el) => {
      const key = el.getAttribute('data-i18n')!;
      const value = getNestedValue(t, key);
      if (value !== undefined) el.textContent = value;
    });

    // HTML content (tagline has <br>)
    document.querySelectorAll<HTMLElement>('[data-i18n-html]').forEach((el) => {
      const key = el.getAttribute('data-i18n-html')!;
      const value = getNestedValue(t, key);
      if (value !== undefined) el.innerHTML = value;
    });

    // Skills list
    const skillItems = document.querySelectorAll('.skills li');
    t.about.skills.forEach((skill: string, i: number) => {
      if (skillItems[i]) skillItems[i].textContent = skill;
    });

    // Page language attribute (accessibility)
    document.documentElement.setAttribute('lang', lang === 'pt' ? 'pt-BR' : 'en');

    // Resume link
    const resumeLink = document.querySelector<HTMLAnchorElement>('.resume-btn');
    if (resumeLink) {
      resumeLink.setAttribute('href', lang === 'pt' ? '/resume-pt.pdf' : '/resume.pdf');
      resumeLink.setAttribute('download', lang === 'pt' ? 'Currículo - Gabriel Gomes.pdf' : 'Resume - Gabriel Gomes.pdf');
    }

    // Toggle button label (shows the OTHER language)
    const toggle = document.querySelector<HTMLButtonElement>('.lang-toggle');
    if (toggle) toggle.textContent = lang === 'en' ? 'PT' : 'EN';

    localStorage.setItem('lang', lang);
    currentLang = lang;
  }

  function toggleLang() {
    applyTranslations(currentLang === 'en' ? 'pt' : 'en');
  }

  // ── Init ──────────────────────────────────────────────────────
  const saved = localStorage.getItem('lang');
  const browser = navigator.language.toLowerCase();
  const initial = saved ?? (browser.startsWith('pt') ? 'pt' : 'en');
  applyTranslations(initial);

  document.querySelector('.lang-toggle')?.addEventListener('click', toggleLang);

  // ── Scroll animations ─────────────────────────────────────────
  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add('visible');
          observer.unobserve(entry.target);
        }
      });
    },
    { threshold: 0.15, rootMargin: '0px 0px -60px 0px' }
  );

  document.querySelectorAll('.animate').forEach((el) => observer.observe(el));

  // ── Nav highlight ─────────────────────────────────────────────
  const navLinks = document.querySelectorAll('nav ul a');
  const navObserver = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          navLinks.forEach((link) => link.classList.remove('active'));
          const active = document.querySelector(`nav ul a[href="#${entry.target.id}"]`);
          if (active) active.classList.add('active');
        }
      });
    },
    { rootMargin: '-40% 0px -55% 0px' }
  );

  document.querySelectorAll('section[id]').forEach((s) => navObserver.observe(s));
</script>
